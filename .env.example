# ملف البيئة النموذجي لمشروع B-Shop — انسخه لملف .env وعدّل القيم براحتك.
# مهم: ممنوع وضع أسرار أو مفاتيح حقيقية في أي ملف داخل المشروع.

# وضع المحاكاة: true = تشغيل كامل بدون باك إند (كل الـ endpoints من طبقة الـ Mock)
NUXT_PUBLIC_API_MOCK=true

# رابط الـ API الحقيقي — يُستخدم فقط عند التحويل للباك إند (راجع docs/06-backend-migration.md)
NUXT_PUBLIC_API_BASE_URL=/api

# بيانات ظاهرة في الواجهة (اسم ونسخة التطبيق)
NUXT_PUBLIC_APP_NAME=B-Shop
NUXT_PUBLIC_APP_VERSION=1.0.0
